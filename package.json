{
  "name": "roomtone",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Every room has an audience. Roomtone measures it with Qloo's cultural taste graph.",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
