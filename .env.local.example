# Qloo hackathon credential.
# Keys are personal and must never be committed. The hackathon key only works
# against the hackathon base URL below — production and staging will 401.
QLOO_API_KEY=hack_your_key_here

QLOO_BASE_URL=https://hackathon.api.qloo.com

# Where the warm response cache lives. Keep it writable so the server keeps
# learning; ship a pre-warmed file for a demo that must never stall.
ROOMTONE_CACHE_FILE=.roomtone-cache.json
